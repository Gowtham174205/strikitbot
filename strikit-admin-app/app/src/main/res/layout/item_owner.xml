<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <!-- Outlined Border style simulation via inner margin/padding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Turf Name & ID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTurfName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_neon"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Camp Nou Turf" />

            <TextView
                android:id="@+id/tvOwnerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBaseline="@id/tvTurfName"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="ID: #12" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/border_dark" />

        <!-- Details Info -->
        <TextView
            android:id="@+id/tvOwnerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Owner: Gowtham P" />

        <TextView
            android:id="@+id/tvOwnerMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Register Number: +919000000000" />

        <TextView
            android:id="@+id/tvBusinessPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Business Bot Number: +918000000000" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:autoLink="web"
            android:textColorLink="@color/accent_blue"
            tools:text="Location: Google Maps Link" />

        <!-- Status Badges Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Verification Status Badge -->
            <TextView
                android:id="@+id/badgeVerified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@color/btn_grey"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_unverified"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="UNVERIFIED" />

            <!-- Subscription Status Badge -->
            <TextView
                android:id="@+id/badgeSubscription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/btn_grey"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_inactive"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="INACTIVE" />
        </LinearLayout>

        <!-- Subscription Expiry Date -->
        <TextView
            android:id="@+id/tvExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Trial Expiry: 2026-06-08 20:00"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/border_dark" />

        <!-- Row: Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Reject Button (shown for approved owners) -->
            <Button
                android:id="@+id/btnReject"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Deactivate"
                android:textColor="@color/btn_reject"
                android:textSize="13sp" />

            <!-- Approve Button (shown for pending/unapproved owners) -->
            <Button
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/btn_approve"
                android:text="Approve"
                android:textColor="@color/bg_dark"
                android:textSize="13sp" />

            <!-- Delete Button (always shown) -->
            <Button
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="@color/btn_delete"
                android:textSize="13sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
