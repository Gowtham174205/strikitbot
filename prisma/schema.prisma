generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model amenities {
  id             BigInt           @id @default(autoincrement())
  name           String           @unique @db.VarChar(255)
  icon           String?          @db.VarChar(255)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  turf_amenities turf_amenities[]
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  role       String?  @db.VarChar(64)
  action     String   @db.VarChar(128)
  details    Json?
  ip_address String?  @db.VarChar(64)
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                             BigInt                  @id @default(autoincrement())
  turf_id                        BigInt
  user_id                        BigInt
  date                           String                  @db.VarChar(16)
  time_slot                      String                  @db.VarChar(32)
  status                         String                  @default("pending") @db.VarChar(32)
  reschedule_count               Int                     @default(0)
  rescheduled_from_id            BigInt?
  owner_id                       BigInt?
  turf_name                      String?                 @db.VarChar(255)
  base_price                     Decimal                 @default(0) @db.Decimal(12, 2)
  commission_amount              Decimal                 @default(0) @db.Decimal(12, 2)
  final_price                    Decimal                 @default(0) @db.Decimal(12, 2)
  created_at                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                @default(now()) @db.Timestamptz(6)
  cancelled_at                   DateTime?               @db.Timestamptz(6)
  refund_percentage              Decimal                 @default(0.0) @db.Decimal(5, 2)
  refund_amount                  Decimal                 @default(0.0) @db.Decimal(12, 2)
  refund_status                  String                  @default("NOT_APPLICABLE") @db.VarChar(32)
  refund_processed_at            DateTime?               @db.Timestamptz(6)
  cancellation_reason            String?
  users_bookings_owner_idTousers users?                  @relation("bookings_owner_idTousers", fields: [owner_id], references: [id], onUpdate: NoAction)
  bookings                       bookings?               @relation("bookingsTobookings", fields: [rescheduled_from_id], references: [id], onUpdate: NoAction)
  other_bookings                 bookings[]              @relation("bookingsTobookings")
  turfs                          turfs                   @relation(fields: [turf_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_bookings_user_idTousers  users                   @relation("bookings_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commission_ledger              commission_ledger[]
  convenience_fee_ledger         convenience_fee_ledger?
  find_match_pools               find_match_pools[]
  invoices                       invoices[]
  match_requests                 match_requests[]
  matches                        matches?
  payments                       payments[]
  refunds                        refunds[]
  reward_transactions            reward_transactions[]
  strikit_point_ledgers          strikit_point_ledgers[]
  strikit_rewards                strikit_rewards[]
  team_booking_rooms             team_booking_rooms[]
  wallet_transactions            wallet_transactions[]

  @@index([owner_id], map: "idx_bookings_owner")
  @@index([status], map: "idx_bookings_status")
  @@index([status, date, time_slot], map: "idx_bookings_status_slot_time")
  @@index([turf_id], map: "idx_bookings_turf")
  @@index([user_id], map: "idx_bookings_user")
  @@index([user_id, status, date, time_slot], map: "idx_bookings_user_status_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commission_ledger {
  id                BigInt   @id @default(autoincrement())
  owner_id          BigInt
  booking_id        BigInt
  payment_id        BigInt   @unique(map: "idx_commission_ledger_payment")
  booking_amount    Decimal  @db.Decimal(12, 2)
  commission_rate   Decimal  @db.Decimal(6, 2)
  commission_amount Decimal  @db.Decimal(12, 2)
  owner_net_amount  Decimal  @db.Decimal(12, 2)
  status            String   @default("APPLIED") @db.VarChar(32)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  bookings          bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments          payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "idx_commission_ledger_booking")
  @@index([owner_id, created_at(sort: Desc)], map: "idx_commission_ledger_owner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model convenience_fee_ledger {
  id           BigInt    @id @default(autoincrement())
  booking_id   BigInt    @unique(map: "idx_convenience_fee_booking")
  payment_id   BigInt?
  user_id      BigInt
  base_amount  Decimal   @db.Decimal(12, 2)
  fee_percent  Decimal   @default(3.0000) @db.Decimal(6, 4)
  fee_amount   Decimal   @db.Decimal(12, 2)
  total_amount Decimal   @db.Decimal(12, 2)
  status       String    @default("PENDING") @db.VarChar(32)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  bookings     bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments     payments? @relation(fields: [payment_id], references: [id], onUpdate: NoAction)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_convenience_fee_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model developer_accounts {
  id                                          BigInt                 @id @default(autoincrement())
  name                                        String                 @db.VarChar(255)
  email                                       String                 @unique @db.VarChar(255)
  password_hash                               String                 @db.VarChar(255)
  role                                        String                 @default("DEVELOPER") @db.VarChar(32)
  is_active                                   Boolean                @default(true)
  login_attempts                              Int                    @default(0)
  lock_until                                  BigInt?
  last_login_at                               DateTime?              @db.Timestamptz(6)
  created_at                                  DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime               @default(now()) @db.Timestamptz(6)
  developer_audit_logs                        developer_audit_logs[]
  turfs                                       turfs[]
  users_users_approved_byTodeveloper_accounts users[]                @relation("users_approved_byTodeveloper_accounts")
  users_users_blocked_byTodeveloper_accounts  users[]                @relation("users_blocked_byTodeveloper_accounts")
  users_users_rejected_byTodeveloper_accounts users[]                @relation("users_rejected_byTodeveloper_accounts")

  @@index([email], map: "idx_developer_accounts_email")
}

model developer_audit_logs {
  id                 BigInt              @id @default(autoincrement())
  developer_id       BigInt?
  action             String              @db.VarChar(128)
  target_type        String?             @db.VarChar(64)
  target_id          BigInt?
  reason             String?
  metadata           Json                @default("{}")
  ip_address         String?             @db.VarChar(64)
  user_agent         String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  developer_accounts developer_accounts? @relation(fields: [developer_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_dev_audit_created")
  @@index([developer_id], map: "idx_dev_audit_developer")
  @@index([target_type, target_id], map: "idx_dev_audit_target")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model find_match_members {
  id                  BigInt           @id @default(autoincrement())
  find_match_pool_id  BigInt
  user_id             BigInt
  status              String           @default("REQUESTED") @db.VarChar(32)
  payment_status      String           @default("PENDING") @db.VarChar(32)
  amount_to_pay       Decimal?         @db.Decimal(12, 2)
  razorpay_order_id   String?          @unique @db.VarChar(255)
  razorpay_payment_id String?          @db.VarChar(255)
  razorpay_signature  String?
  joined_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  find_match_pools    find_match_pools @relation(fields: [find_match_pool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([find_match_pool_id, user_id])
  @@index([find_match_pool_id, status, payment_status], map: "idx_find_match_members_pool")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model find_match_pools {
  id                 BigInt               @id @default(autoincrement())
  sport_type         String               @db.VarChar(64)
  area               String?              @db.VarChar(255)
  city               String?              @db.VarChar(255)
  latitude           Float?
  longitude          Float?
  captain_user_id    BigInt
  required_players   Int                  @default(14)
  confirmed_players  Int                  @default(1)
  paid_players       Int                  @default(0)
  status             String               @default("WAITING_FOR_PLAYERS") @db.VarChar(32)
  search_start_time  DateTime             @default(dbgenerated("'19:00:00'::time without time zone")) @db.Time(6)
  search_end_time    DateTime             @default(dbgenerated("'23:00:00'::time without time zone")) @db.Time(6)
  search_days        Int                  @default(7)
  split_amount       Decimal?             @db.Decimal(12, 2)
  booking_id         BigInt?
  selected_turf_id   BigInt?
  selected_date      String?              @db.VarChar(16)
  selected_time_slot String?              @db.VarChar(32)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  find_match_members find_match_members[]
  bookings           bookings?            @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  users              users                @relation(fields: [captain_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turfs              turfs?               @relation(fields: [selected_turf_id], references: [id], onUpdate: NoAction)

  @@index([status, sport_type, city, created_at], map: "idx_find_match_pools_search")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id                             BigInt   @id @default(autoincrement())
  invoice_number                 String   @unique @db.VarChar(64)
  invoice_type                   String   @db.VarChar(64)
  booking_id                     BigInt
  payment_id                     BigInt
  owner_id                       BigInt?
  user_id                        BigInt?
  turf_id                        BigInt?
  gross_amount                   Decimal  @default(0) @db.Decimal(12, 2)
  commission_rate                Decimal  @default(0) @db.Decimal(6, 2)
  commission_amount              Decimal  @default(0) @db.Decimal(12, 2)
  owner_net_amount               Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount                     Decimal  @default(0) @db.Decimal(12, 2)
  total_amount                   Decimal  @default(0) @db.Decimal(12, 2)
  status                         String   @default("GENERATED") @db.VarChar(32)
