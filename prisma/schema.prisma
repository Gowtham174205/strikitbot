generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BotOwner {
  id                    Int               @id @default(autoincrement())
  name                  String
  mobile                String            @unique
  turfName              String
  location              String
  photoUrls             String
  gst                   String?
  msme                  String?
  verified              Boolean           @default(false)
  businessPhone         String?           @unique
  subscriptionActive    Boolean           @default(false)
  subscriptionExpiry    DateTime?
  createdAt             DateTime          @default(now())
  closingTime           String            @default("10:00 PM")
  openingTime           String            @default("06:00 AM")
  pricePerHour          Float             @default(1000.0)
  razorpayContactId     String?
  razorpayFundAccountId String?
  upiId                 String?
  latitude              Float?
  longitude             Float?
  pricePerHourPaise     Int?
  subscriptionPlan      String?           @default("TRIAL") @db.VarChar
  msmeCardUrl           String?
  utilityBillUrl        String?
  BotPayoutLedger       BotPayoutLedger[]
  slots                 BotTurfSlot[]
}

model BotTurfSlot {
  id             Int          @id @default(autoincrement())
  ownerId        Int
  date           String
  timeSlot       String
  status         String
  blockedByOwner Boolean      @default(false)
  createdAt      DateTime     @default(now())
  bookings       BotBooking[]
  owner          BotOwner     @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, date, timeSlot])
}

model BotBooking {
  id                 Int                  @id @default(autoincrement())
  slotId             Int
  teamName           String
  captainName        String
  captainPhone       String
  paymentId          String?
  amountPaid         Float
  createdAt          DateTime             @default(now())
  totalPaidPaise     Int?
  ownerSharePaise    Int?
  platformFeePaise   Int?
  paymentStatus      String?              @db.VarChar
  payoutStatus       String?              @db.VarChar
  confirmedAt        DateTime?            @db.Timestamp(6)
  paymentLinkId      String?              @db.VarChar
  razorpayPaymentId  String?              @db.VarChar
  sport              String?              @db.VarChar
  slot               BotTurfSlot          @relation(fields: [slotId], references: [id])
  joinRequests       BotJoinRequest[]
  BotPaymentAuditLog BotPaymentAuditLog[]
  BotPayoutLedger    BotPayoutLedger[]
}

model BotJoinRequest {
  id            Int        @id @default(autoincrement())
  bookingId     Int
  playerName    String
  playerPhone   String
  status        String
  joiningAmount Float?
  createdAt     DateTime   @default(now())
  booking       BotBooking @relation(fields: [bookingId], references: [id])
}

model BotSession {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  role      String
  state     String
  context   String?
  updatedAt DateTime @updatedAt
  language  String?  @db.VarChar
}

model BotPaymentAuditLog {
  id         Int         @id @default(autoincrement())
  bookingId  Int?
  eventType  String      @db.VarChar
  payload    String?
  message    String      @db.VarChar
  createdAt  DateTime?   @db.Timestamp(6)
  BotBooking BotBooking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model BotPayoutLedger {
  id                Int        @id @default(autoincrement())
  bookingId         Int
  ownerId           Int
  razorpayPaymentId String     @db.VarChar
  razorpayPayoutId  String?    @db.VarChar
  totalPaidPaise    Int
  ownerSharePaise   Int
  platformFeePaise  Int
  ownerUpiId        String     @db.VarChar
  status            String?    @db.VarChar
  idempotencyKey    String     @unique @db.VarChar
  attemptCount      Int?
  failureReason     String?    @db.VarChar
  createdAt         DateTime?  @db.Timestamp(6)
  updatedAt         DateTime?  @db.Timestamp(6)
  BotBooking        BotBooking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  BotOwner          BotOwner   @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}
