  turfs                          turfs?   @relation(fields: [turf_id], references: [id], onUpdate: NoAction)
  users_invoices_user_idTousers  users?   @relation("invoices_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([booking_id, payment_id], map: "idx_invoices_booking_payment")
  @@index([owner_id, created_at(sort: Desc)], map: "idx_invoices_owner")
  @@index([invoice_type, created_at(sort: Desc)], map: "idx_invoices_type")
}

