# STRIKIT Python Bot — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/strikit

# ── WhatsApp Meta Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=STRIKIT_TOKEN
WHATSAPP_APP_SECRET=
ONBOARDING_NUMBER=919360756749

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ── Admin ──
ADMIN_API_KEY=your-secure-admin-key-here
DEVELOPER_NUMBERS=919360756749

# ── Platform Fees (PAISE) ──
PLATFORM_BOOKING_FEE_PAISE=5000
PLATFORM_JOIN_FEE_PAISE=900
SUBSCRIPTION_FEE_PAISE=69900

# ── WhatsApp API ──
WHATSAPP_API_VERSION=v21.0

# ── Server URLs ──
BASE_URL=https://bot.strikit.in
LOG_LEVEL=INFO
